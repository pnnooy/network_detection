% BibTeX 参考文献文件
% 使用方法：在 .tex 文件中使用 \cite{key} 来引用

% ========================================
% 会议论文示例
% ========================================
@inproceedings{example1,
  author    = {First Author and Second Author and Third Author},
  title     = {Title of the Conference Paper},
  booktitle = {Proceedings of the Conference on Network and Distributed System Security (NDSS)},
  year      = {2024},
  pages     = {1--15},
  doi       = {10.xxxx/xxxxx},
  url       = {https://example.com/paper.pdf}
}

% ========================================
% 期刊论文示例
% ========================================
@article{example2,
  author  = {Author Name and Another Author},
  title   = {Title of the Journal Article},
  journal = {IEEE Transactions on Information Forensics and Security},
  year    = {2023},
  volume  = {18},
  number  = {5},
  pages   = {1234--1250},
  doi     = {10.1109/TIFS.2023.xxxxx}
}

% ========================================
% 书籍示例
% ========================================
@book{example3,
  author    = {Book Author},
  title     = {Title of the Book},
  publisher = {Publisher Name},
  year      = {2022},
  edition   = {3rd},
  isbn      = {978-0-xxx-xxxxx-x}
}

% ========================================
% 技术报告示例
% ========================================
@techreport{example4,
  author      = {Report Author},
  title       = {Title of Technical Report},
  institution = {Institution Name},
  year        = {2023},
  number      = {TR-2023-01},
  url         = {https://example.com/report.pdf}
}

% ========================================
% 在线资源/网页示例
% ========================================
@misc{example5,
  author       = {Organization or Author Name},
  title        = {Title of the Webpage or Resource},
  year         = {2024},
  howpublished = {\url{https://example.com}},
  note         = {Accessed: 2024-06-15}
}

% ========================================
% arXiv 预印本示例
% ========================================
@misc{example6,
  author        = {Author Name and Coauthor Name},
  title         = {Title of the Arxiv Paper},
  year          = {2024},
  eprint        = {2401.12345},
  archivePrefix = {arXiv},
  primaryClass  = {cs.CR},
  url           = {https://arxiv.org/abs/2401.12345}
}

% ========================================
% 博士/硕士论文示例
% ========================================
@phdthesis{example7,
  author  = {Student Name},
  title   = {Title of the Dissertation},
  school  = {University Name},
  year    = {2023},
  address = {City, Country}
}

% ========================================
% 专利示例
% ========================================
@misc{example8,
  author       = {Inventor Name},
  title        = {Patent Title},
  year         = {2022},
  howpublished = {U.S. Patent No. 11,234,567},
  note         = {Filed: Jan 2020, Issued: Mar 2022}
}

% ========================================
% 软件/代码仓库示例
% ========================================
@misc{example9,
  author       = {Developer Name},
  title        = {Software or Repository Name},
  year         = {2024},
  howpublished = {\url{https://github.com/username/repository}},
  note         = {Version 1.0.0}
}

% ========================================
% 数据集示例
% ========================================
@misc{example10,
  author       = {Dataset Creator},
  title        = {Name of Dataset},
  year         = {2023},
  howpublished = {\url{https://example.com/dataset}},
  note         = {Dataset version 2.0}
}
